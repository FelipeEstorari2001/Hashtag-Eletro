	measure '% das Vendas (Loja)' = [Qtd Vendida (loja com mais vendas)]/[Total Vendas]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2a2d94cb-9719-44ca-9d15-fb5e8e85eb4d

	measure 'Faturamento Perdido' =
			
			SUMX(
			    'fDevoluções',
			    'fDevoluções'[Qtd Devolvida]*RELATED(dProdutos[Preço Unitario]))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: b4508cb4-97cc-4266-971a-3bb73ebfb0d0

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% De Faturamento Perdido' = [Faturamento Perdido]/[Faturamento Total]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8906b6f0-2522-41f0-b80c-24b8022cc174

	measure 'Mês Selecionado' = SELECTEDVALUE(dCalendario[Inicio do Mês].[Mês],"Mês")
		lineageTag: c0059acf-9030-479d-ab5e-7d76cacdd6a9

	measure 'Nome da Categoria' = SELECTEDVALUE(dProdutos[Tipo do Produto],"Nome Do Produto")
